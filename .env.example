# Copy to .env and fill in. docker compose reads .env automatically.

# The Roon Core's IP address (required). Give it a DHCP reservation so it stays put.
ROON_HOST=192.168.1.20

# The Core's API port. Roon 2.x uses 9330.
ROON_PORT=9330

# Zone used when a request doesn't name one.
ROON_ZONE=Lounge

# Step for volume up/down, on a 0-100 scale.
ROON_VOLUME_STEP=2

# Port on the Docker host for the API.
ROON_BRIDGE_PORT=8080
